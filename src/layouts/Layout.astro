---
import '../styles/tokens.css';
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>At Time | Lo bueno de tu barrio, a tiempo</title>
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-inner">
      <a href="/" class="brand">
        <svg width="28" height="34" viewBox="0 0 60 72" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M30 0C13.43 0 0 13.43 0 30C0 51.5 30 72 30 72C30 72 60 51.5 60 30C60 13.43 46.57 0 30 0Z" fill="#EE6C35"/>
          <circle cx="30" cy="29" r="18" fill="#FDF5E8"/>
          <path d="M30 18V29L38 33" stroke="#102B38" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>At Time</span>
      </a>
      <span class="brand-badge">Piloto Manizales · U. de Caldas</span>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <p>
        At Time — Proyecto Integrador · Gestión Empresarial de TI 2, Universidad de Caldas (Manizales) ·
        <a href="/privacidad">Política de Tratamiento de Datos</a>
      </p>
    </div>
  </footer>
</body>
</html>