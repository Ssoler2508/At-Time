---
import Layout from '../layouts/Layout.astro';
import ExplorarApp from '../components/explorar/ExplorarApp';
---

<Layout>
  <div class="aviso-prototipo">
    <strong>Prototipo de demostración.</strong>
    Los negocios, nombres y cifras son ejemplos ficticios, no representan negocios ni resultados reales.
  </div>

  <ExplorarApp client:load />
</Layout>

<style>
  .aviso-prototipo {
    background: #fff4e6;
    border-bottom: 3px solid #ffc857;
    padding: 10px 16px;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #14323f;
    border-radius: 0;
border-top: 0;
margin: 0;
  }
</style>