---
import Layout from '../layouts/Layout.astro';
import { SessionBar } from '../components/explorar/SessionBar';
import { BusinessList } from '../components/explorar/BusinessList';
import { BusinessPanel } from '../components/explorar/BusinessPanel';
---

<style>
  .aviso-prototipo {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--spacing-md) var(--spacing-lg);
    margin: -var(--spacing-lg) -var(--spacing-lg) var(--spacing-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>

<Layout>
  <div class="aviso-prototipo" style={{ position: 'sticky', top: 0, zIndex: 10, background: 'var(--color-surface)', borderColor: 'var(--color-border)' }}>
    Prototipo de demostración. Los negocios, nombres y cifras son ejemplos ficticios, no representan negocios ni resultados reales.
  </div>
  <SessionBar />
  <section class="contenido-explorar">
    <BusinessList />
    <BusinessPanel />
  </section>
</Layout>